{
  "version": 2,
  "name": "eco-saferide",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/MOBILE_APP_SIMULATOR/index.html" },
    { "source": "/manifest.json", "destination": "/MOBILE_APP_SIMULATOR/manifest.json" },
    { "source": "/sw.js", "destination": "/MOBILE_APP_SIMULATOR/sw.js" },
    { "source": "/icon-192.png", "destination": "/MOBILE_APP_SIMULATOR/icon-192.png" },
    { "source": "/icon-512.png", "destination": "/MOBILE_APP_SIMULATOR/icon-512.png" },
    { "source": "/(.*)", "destination": "/MOBILE_APP_SIMULATOR/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(self), gyroscope=(self), magnetometer=(self)"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
